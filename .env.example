# Local development configuration for the reference recruiter slice.
# Copy to `.env` and fill only the provider path you intend to use.

# SQLite file path. Use empty string for in-memory runtime.
VERTICAL_SLICE_DB_PATH=data/app.db

# Provider selection: stub | openai | openrouter
# - `stub` is deterministic and recommended for tests/local dry runs.
# - `openai` / `openrouter` require API keys below.
LLM_PROVIDER=stub
LLM_MODEL=gpt-4.1-mini

# Shared fallback key name if you prefer one variable.
LLM_API_KEY=

# Provider-specific keys.
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Optional explicit env file path override for the FastAPI app boundary.
# VERTICAL_SLICE_ENV_FILE=.env

# Optional live smoke test gate (not part of the default suite).
# RUN_LLM_PROVIDER_LIVE_SMOKE=1
